rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /player_secrets/{playerId} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // 公開ページ表示用に読み取りは許可する。
    // 書き込みは Firebase Auth または Cloud Functions 経由で行う。
    match /players/{playerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /point_history/{historyId} {
      allow read: if false;
      allow write: if request.auth != null;
    }

    // ホームのレート推移グラフ用。point_history を集計した日別の値だけを持つ。
    // 中身はランキングと同じ公開情報なので読み取りは許可する。
    match /rate_chart/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sports_bets/{betId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /speedstorm_records/{recordId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /lotteries/{lotteryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gift_codes/{giftCodeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /career_posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /manaba_credentials/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /manaba_assignments/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /push_tokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ルーレットの持ち込み・手元チップ。残高を書き換えられると精算額を偽れるので、
    // 読み書きとも Cloud Functions (casinoRoulette) だけに限る。
    match /casino_sessions/{userId} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
