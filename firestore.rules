rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /player_secrets/{playerId} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // 公開ページ表示用に読み取りは許可する。
    // 書き込みは Firebase Auth または Cloud Functions 経由で行う。
    match /players/{playerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /point_history/{historyId} {
      allow read: if false;
      allow write: if request.auth != null;
    }

    // ホームのレート推移グラフ用。point_history を集計した日別の値だけを持つ。
    // 中身はランキングと同じ公開情報なので読み取りは許可する。
    match /rate_chart/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sports_bets/{betId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /speedstorm_records/{recordId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /lotteries/{lotteryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gift_codes/{giftCodeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /career_posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /manaba_credentials/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /manaba_assignments/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /push_tokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // カジノ (ブラックジャック・スロット・宝探し・成り上がり) の持ち込み・手元チップ・配られたカード。
    // 残高を書き換えられると精算額を偽れ、読めるとディーラーの伏せ札が見えてしまうので、
    // 読み書きとも Cloud Functions (casino) だけに限る。
    match /casino_sessions/{userId} {
      allow read, write: if false;
    }

    // 自動精算の結果 (本人の次の画面で1回だけ見せる)。Cloud Functions だけが読み書きする。
    match /casino_notices/{userId} {
      allow read, write: if false;
    }

    // ブラックジャックの卓。中身はディーラーの裏札を含むので Cloud Functions だけに限る。
    match /bj_tables/{tableId} {
      allow read, write: if false;
    }

    // 卓を誰でも読める形に直したもの (裏札と uid は含まない)。画面はこれを読み直して
    // ほかの人の操作を反映する。書き込みは Cloud Functions (casino) だけ。
    match /bj_public/{tableId} {
      allow read: if true;
      allow write: if false;
    }

    // 宝探しの卓。中身 (券を買った人の uid を含む) は Cloud Functions だけに限る。
    match /gappori_tables/{tableId} {
      allow read, write: if false;
    }

    // 卓を誰でも読める形に直したもの (uid は含まない)。
    match /gappori_public/{tableId} {
      allow read: if true;
      allow write: if false;
    }

    // 沈没の船。中身 (沈む時刻・誰が飛び降りたか) は Cloud Functions だけに限る。
    match /sink_tables/{tableId} {
      allow read, write: if false;
    }

    // 船を誰でも読める形に直したもの (沈む時刻と、航海中に誰が飛び降りたかは含まない)。
    match /sink_public/{tableId} {
      allow read: if true;
      allow write: if false;
    }

    // 航海 (大海賊の航海日誌。2026/10/5〜12/21) のみんなで共有する分 (ジャックポット・最終秘宝・取り分の合計・直近の JP)。
    // 画面はこれを読んで JP を出す。書き込みは Cloud Functions (casino) だけ。
    match /voyage_public/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 航海の人ごとの分 (位置・周回・航海した金額・スタンプ)。書き換えられると取り分を偽れるので Cloud Functions だけに限る。
    match /voyage_players/{userId} {
      allow read, write: if false;
    }

    // テキサスホールデム (holdem_tables / holdem_public / holdem_hole) は 52.0 で廃止した。
    // ルールを置かないので、残っているドキュメントは誰も読み書きできない。

    // レートの貸し出し (借金) の記録。借金の額はランキングとグラフに出す公開情報なので読み取りは許可する。
    // 書き換えられると返済を偽れるので、書き込みは Cloud Functions (loan / 日次補正) だけに限る。
    match /loans/{playerId} {
      allow read: if true;
      allow write: if false;
    }

    // 船底 (地下労働) の金貨と仕分けの途中の便。積荷の並び (答え) を含み、書き換えられると金貨を偽れるので、
    // 読み書きとも Cloud Functions (underground) だけに限る。
    match /underground/{playerId} {
      allow read, write: if false;
    }

    // 指名手配の盤面 (伏せたカードの絵柄を含む) と賞金首の記録。読めると盤面が丸見えになり、
    // 書き換えられるとレートを偽れるので、読み書きとも Cloud Functions (wanted) だけに限る。
    match /wanted_boards/{userId} {
      allow read, write: if false;
    }

    match /wanted_bounties/{playerId} {
      allow read, write: if false;
    }

    // AIカンカクの問題ごとの BET と人ごとの合計。書き換えられるとレートを偽れるので、
    // 読み書きとも Cloud Functions (aikankaku) だけに限る (答えはお題と一緒に Cloud Functions の中だけにある)。
    match /aikankaku_days/{dateKey} {
      allow read, write: if false;
    }

    match /aikankaku_players/{userId} {
      allow read, write: if false;
    }

    // スロットのジャックポットタイムの状態 (残りの回数・天井までの回数・固定の賭け金)。
    // 書き換えられるとジャックポットタイムを偽れるので、読み書きとも Cloud Functions (casino) だけに限る。
    match /slot_states/{userId} {
      allow read, write: if false;
    }

    // 日次レート補正を済ませた日の記録。同じ日に2回動かさないための印なので、Cloud Functions だけが読み書きする。
    match /rate_reversion_runs/{date} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
